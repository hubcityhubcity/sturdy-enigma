# Copy this file to .env.production and replace every placeholder before launch.
# Never commit the real .env.production file.

POSTGRES_PASSWORD=replace_with_a_long_random_password
ALLOWED_ORIGINS=https://app.example.com
TITAN_REQUIRE_WORKSPACE_KEY=true
TITAN_DEVELOPMENT_WORKSPACE_KEY=replace_with_a_long_random_workspace_secret
RENDER_WORKER_POLL_SECONDS=2

# The current MVP uses local/shared storage. For multi-machine scaling, replace this
# with object-storage-backed media handling before adding more than one API/worker node.
